{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "shark-chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"secrets": {
		"required": [
			"OPENROUTER_API_KEY"
		]
	},
	"routes": [
		{
			"pattern": "api.gojunana00.com",
			"zone_name": "gojunana00.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shark-chat-db",
			"database_id": "d11b0601-ad70-4661-af7a-1b74b4bcfe3c",
		}
	],
	"env": {
		"staging": {
			"name": "shark-chat-staging",
			"routes": [],   // ← 本番のドメインを引き継がないようにする
			"d1_databases": [
				{
					"binding": "DB", // 本番と同じbinding名にする
					"database_name": "shark-chat-db-staging",
					"database_id": "e60f96a8-d73b-49d8-a170-1f78ff7eef22"
				}
			],
			"secrets": {
				"required": [
					"OPENROUTER_API_KEY"
				]
			}
		}
	}
}
