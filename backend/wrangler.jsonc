{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "shark-chat",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"secrets": {
		"required": [
			"OPENROUTER_API_KEY"
		]
	},
	"routes": [
		{
			"pattern": "api.gojunana00.com",
			"zone_name": "gojunana00.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shark-chat-db",
			"database_id": "d11b0601-ad70-4661-af7a-1b74b4bcfe3c",
		}
	]
}
